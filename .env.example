# Student Query Resolution Platform (SQRP) - Environment Variables Template
# Copy this file to .env.local and fill in the values

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public Keys (Safe for Client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Server-Only Secret (NEVER expose to client!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# AI Provider Configuration (Server-Side Only)
# Supported providers: gemini | openai | groq | local-fallback
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-or-openai-api-key-here
AI_MODEL_NAME=gemini-1.5-flash

# Platform Settings
NEXT_PUBLIC_INSTITUTION_NAME="National Institute of Technology & Engineering"
NEXT_PUBLIC_ACADEMIC_YEAR="2025-2026"
NEXT_PUBLIC_TICKET_PREFIX="SQRP-2026"
